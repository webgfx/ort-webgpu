{
  "name": "ort-webgpu-benchmarks",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone, correctness-checked ORT WebGPU Web and native benchmarks",
  "scripts": {
    "build:web-page": "node web/build-page.mjs",
    "test:web-page": "node web/page.browser.cjs",
