    "test:browser": "node web/generator.browser.cjs && node web/gpu-greedy.browser.cjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "puppeteer-core": "25.10.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
