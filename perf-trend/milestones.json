  "optimizationGroups": [
    {
      "id": "prefill",
      "title": "Prefill optimizations",
      "kicker": "Prompt processing",
      "description": "Increase throughput across the full prompt.",
      "metric": "prefillTps",
      "metricLabel": "prefill tok/s",
      "reference": {
        "date": "2024-12-02",
        "label": "December 2, 2024 starting measurement",
        "chartLabel": "Starting point",
        "measurement": {
          "prefillTps": 272.116
        },
        "ortCommit": "8c52fa392434e25ccdf0a0645a4eb6e4865074fa",
        "genaiCommit": "c5745fd6d91a2ba2d94c6a52f6255652dde02508",
        "note": "Measured on RTX 5080 with the archived December 2 runtime snapshot and the maintained accuracy-level-4, graph-ready, unfused-RoPE model."
      },
      "stages": [
        {
          "id": "02-subgroup-prefill",
          "summary": "Use WebGPU subgroup operations in MatMulNBits to exchange quantized tiles within a wave."
        },
        {
          "id": "03-dp4a-prefill",
          "summary": "Use packed four-lane integer dot products for the quantized MatMulNBits prefill path."
        },
        {
          "id": "03-gqa-flash-prefill",
          "summary": "Enable the FlashAttention path for grouped-query attention during prompt processing."
        },
        {
          "id": "06-shared-memory-broadcast",
          "summary": "Broadcast FlashAttention K/V values through workgroup shared memory on NVIDIA GPUs."
        },
        {
          "id": "07-prune",
          "summary": "Evaluate the LM head only for the final prompt token instead of every prompt token."
        },
        {
          "id": "10-flashattention-max-k-step",
          "summary": "Select a larger FlashAttention max K-step dynamically from the NVIDIA workgroup-memory budget."
        }
      ]
    },
    {
      "id": "decode",
      "title": "Decode optimizations",
      "kicker": "Token generation",
      "description": "Reduce per-token dispatch, attention, and quantized MLP overhead.",
      "metric": "decodeTps",
      "metricLabel": "decode tok/s",
      "reference": {
        "date": "2024-12-11",
        "label": "December 2024 starting measurement",
        "chartLabel": "Starting point",
        "measurement": {
          "decodeTps": 69.96
        }
      },
      "stages": [
        {
          "id": "04-gqa-flash-decode",
          "summary": "Introduce Flash Decoding for one-token generation and GQA KV-cache reads."
        },
        {
          "id": "06-gqa-rope",
          "summary": "Fuse packed-QKV splitting with rotary embedding in the GQA generation path."
        },
        {
          "id": "08-graph-capture",
          "label": "WebGPU graph capture",
          "summary": "Enable WebGPU graph capture in ORT GenAI and replay generation commands to reduce CPU submission overhead."
        },
        {
          "id": "09-matmulnbits-mlp",
          "summary": "Fuse quantized MatMulNBits MLP work in the token-generation path."
        },
      {
        "id": "11-flashattention-decode-tuning",
        "summary": "Increase FlashAttention decode occupancy with a larger workgroup and K tile."
      }
      ]
    }
  ],
