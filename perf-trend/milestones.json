  "importantGenaiConfigOptions": [
    {
      "path": "provider_options.webgpu.enableGraphCapture",
      "location": "webgpu provider options",
      "profile": "\"0\" stored; \"1\" for the controlled graph-capture performance run",
      "description": "Enables command-graph capture and replay. Keep the archived model config disabled so the graph-capture milestone remains an explicit benchmark-time override."
    },
    {
      "path": "provider_options.webgpu.validationMode",
      "location": "webgpu provider options",
      "profile": "\"basic\" stored; \"disabled\" for the controlled performance run",
      "description": "Avoids WebGPU validation overhead in measured runs while retaining basic validation in the archived model config."
    },
    {
      "path": "optimization.disable_specified_optimizers",
      "location": "decoder session_options",
      "profile": "\"ConstantFolding\" when constant folding should be disabled",
      "description": "Disables only ORT's ConstantFolding transformer. The ORT default is an empty value, so no optimizer is disabled; this primarily changes session creation rather than steady-state throughput."
    },
    {
      "path": "provider_options.webgpu.multiRotaryCacheConcatOffset",
      "location": "webgpu provider options",
      "profile": "\"4096\" only for a model with concatenated short/long rotary caches",
      "description": "Supplies the split offset required by the concatenated multi-RoPE cache layout; omit it for models that do not use that layout."
    }
  ],
